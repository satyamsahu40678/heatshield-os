# Local synthetic demonstration only. Do not reuse these values on a hosted system.
POSTGRES_PASSWORD=heatshield-demo-only-password
HEATSHIELD_DEMO=true
# Add sample walkthroughs without resetting existing records. Disable for an empty workspace.
HEATSHIELD_DEMO_CONTENT=true
HEATSHIELD_JWT_SECRET=heatshield-synthetic-demo-only-signing-key-change-before-deployment
HEATSHIELD_PORT=8000

# Direct Python startup uses SQLite by default. Set a database URL explicitly
# for PostgreSQL. Compose constructs its own URL using POSTGRES_PASSWORD and db.
# HEATSHIELD_DATABASE_URL=postgresql+psycopg://heatshield:password@127.0.0.1:5432/heatshield

# Production configuration requires HEATSHIELD_DEMO=false, independent random
# database/JWT secrets, authenticated account provisioning, HTTPS, and policy
# review. Use URL-safe PostgreSQL passwords here, or percent-encode the URL.
